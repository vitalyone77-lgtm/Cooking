# =====================================================================================
#  ШАБЛОН НАСТРОЕК. Копия этого файла с твоими значениями называется .env (в git не попадает).
#  Файл .env на сервере (/root/Cooking/.env) и на компьютере — РАЗНЫЕ файлы: правишь в одном —
#  в другом ничего не меняется. После правки .env на сервере перезапусти службы:
#      systemctl restart Cooking cooking-web
#
#  ОБОЗНАЧЕНИЯ:
#    [ОБЯЗАТЕЛЬНО]  без этого не заработает
#    [⚠ ДОБАВЬ]     НОВОЕ — этих строк у тебя в .env ещё нет, добавь их
#    [по желанию]   есть значение по умолчанию, можно не трогать
# =====================================================================================

# -------------------------------------------------------------------------------------
#  СОСТОЯНИЕ (01.10.2026): на СЕРВЕРЕ в /root/Cooking/.env уже есть всё, включая WEB_APP_URL, WEB_SECRET,
#  ADMIN_PASSWORD и GROQ_MODEL=llama-3.3-70b-versatile; локально — ADMIN_PASSWORD, WEB_APP_URL, GROQ_MODEL тоже.
#  Если разворачиваешь проект заново, ДОБАВЬ строки с пометкой [⚠ ДОБАВЬ] в блоке «Веб-версия» ниже.
#
#  ПАРОЛЬ с символами $ # ! ' пробелами записывай в одинарных кавычках: ADMIN_PASSWORD='мой#пароль$1'
#  (без кавычек часть символов может «съесться»). Пароль, показанный в чате, лучше сменить.
#
#  Строку WEB_ALLOWED_ORIGINS= из старого .env можно УДАЛИТЬ — она устарела, не используется.
#  Пошаговая инструкция: DEPLOY_WEB.md
# -------------------------------------------------------------------------------------


# ============================ Telegram-бот ===========================================
# [ОБЯЗАТЕЛЬНО] Токен бота от @BotFather
BOT_TOKEN=


# ============================ ИИ (генерация рецептов) ================================
# [по желанию] Основной провайдер: deepseek, groq или openrouter.
# При сбое или пустом ответе бот сам пробует остальные по порядку deepseek -> groq -> openrouter
# (тех, у кого задан ключ).
LLM_PROVIDER=deepseek

# [ОБЯЗАТЕЛЬНО] Ключ DeepSeek (platform.deepseek.com) — основной провайдер.
# Для этого проекта лучше отдельный ключ (отдельный учёт расходов).
DEEPSEEK_API_KEY=
# [по желанию] Текущая модель — deepseek-flash. Старые имена deepseek-chat / deepseek-reasoner
# отключены с 24.07.2026 — не используй. «Режим размышлений» у новых моделей включён по
# умолчанию, поэтому ai.py сам отправляет thinking:disabled в каждом запросе.
DEEPSEEK_MODEL=deepseek-flash

# [по желанию] Резерв №1 — Groq (console.groq.com), бесплатный и быстрый.
# Не ставь модели openai/gpt-oss-* — они иногда отвечают пустым текстом (см. историю в PROJECT.md).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# [по желанию] Резерв №2 — OpenRouter (openrouter.ai/keys).
# Замечание: в тесте 28.09 этот резерв отвечал 404 — проверь модель/ключ, прежде чем на него рассчитывать.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free


# ============================ Поиск рецептов в интернете =============================
# [ОБЯЗАТЕЛЬНО для качества] Tavily (tavily.com) — основной поиск, без рейтлимитов.
# Без ключа бот ищет через DuckDuckGo (бесплатно, но с сервера часто «202 Ratelimit»).
TAVILY_API_KEY=
# Платный резервный поиск DeepSeek ($0.75 за 1000 запросов), только если Tavily и DuckDuckGo ничего не нашли
DEEPSEEK_SEARCH_ENABLED=true


# ============================ Напоминание «что приготовить завтра» ===================
# [по желанию] Каждый день в это время бот предлагает новое блюдо тем, кто уже получал рецепт.
REMINDER_ENABLED=true
REMINDER_HOUR=14
REMINDER_MINUTE=0
REMINDER_TIMEZONE=Europe/Moscow


# ============================ Магазины (ссылки, цены ВкусВилла) ======================
# [по желанию] Цены и корзина ВкусВилла через официальный MCP (ключ не нужен). Выключить: false
VKUSVILL_PRICES_ENABLED=true
# [по желанию] Лимит времени на подсчёт цен корзины (секунды), дальше показываем только ссылки
# STORE_PRICES_TIMEOUT=40
# [по желанию] Адреса MCP ВкусВилла (через запятую) и ключ, если понадобится
# VKUSVILL_MCP_URL=https://mcp.vkusvill.ru/mcp,https://mcp001.vkusvill.ru/mcp
# VKUSVILL_MCP_API_KEY=
# [по желанию] Шаблоны ссылок поиска ({q} — запрос). Если ссылка Лавки/Купера не открывает поиск — поправь здесь
# STORE_URL_FIVEKA=https://5ka.ru/search/?text={q}
# STORE_URL_VKUSVILL=https://vkusvill.ru/search/?q={q}
# STORE_URL_LAVKA=https://lavka.yandex.ru/search?text={q}
# STORE_URL_PEREKRESTOK=https://www.perekrestok.ru/cat/search?search={q}
# STORE_URL_KUPER=https://web.kuper.ru/multisearch?q={q}


# ============================ Веб-версия (сайт + API + админка) ======================
# Подробности и порядок запуска: DEPLOY_WEB.md. Поддомен menu.ymayaka.ru уже указывает на сервер.

# [⚠ ДОБАВЬ] Публичный адрес сайта. Бот присылает его по команде /app, он же печатается в подвале PDF.
WEB_APP_URL=https://menu.ymayaka.ru

# [⚠ ДОБАВЬ] Случайная длинная строка — подпись cookie входа в админку.
# Получить на сервере одной командой (скопируй результат в эту строку):
#     /root/Cooking/venv/bin/python -c "import secrets;print(secrets.token_urlsafe(32))"
WEB_SECRET=

# [⚠ ДОБАВЬ] Пароль входа на https://menu.ymayaka.ru/admin. Длинный (20+ символов), только
# буквы и цифры (знаки $ # " ' и пробелы в .env могут «съесться»). Пустой пароль = админка закрыта.
ADMIN_PASSWORD=

# [по желанию] Лимиты веба на одно устройство (защита бюджета DeepSeek; в боте лимитов нет):
# блюд в сутки / меню на день в сутки / планов на 3 дня за 3 календарных дня (сутки по Москве)
WEB_LIMIT_RECIPE=3
WEB_LIMIT_DAYMENU=1
WEB_LIMIT_WEEK=1
# замен «нет таких-то продуктов в магазине» в сутки
WEB_LIMIT_MISSING=5

# [по желанию] Коды подтверждения сайта для поисковиков (только сам код из content="...").
# Яндекс Вебмастер → Добавить сайт → «Метатег»; Google Search Console → «Тег HTML». После правки: systemctl restart cooking-web
# YANDEX_VERIFICATION=
# GOOGLE_SITE_VERIFICATION=

# [по желанию] Папка данных веба (база, избранное и меню веб-пользователей). Резервную копию делай с неё.
# WEB_DATA_DIR=web_data

# [по желанию] Шрифт для PDF, если на сервере нет DejaVu (Ubuntu: /usr/share/fonts/truetype/dejavu/ — есть)
# PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Общий потолок генераций ИИ в сутки на бот + сайт + напоминания (0 — без потолка)
DAILY_GEN_CAP=500
# Напоминания — только пропавшим: первое через 4 дня без визитов, второе ещё через 6, больше не шлём
REMINDER_GAPS=4,6

# ---------- Защита от накрутки ----------
# Дневной запас для сайта без входа через Telegram (внутри общего потолка) и подборов с одного IP
DAILY_GEN_CAP_ANON=150
WEB_IP_DAILY_GENS=40

# ---------- Подписка (plans.py) ----------
# false — у всех прежние лимиты (LIMITS_OPEN), ничего не продаётся. true — бесплатный план + подписка.
PAYWALL_ENABLED=false
# Лимит «вид=сколько/за сколько дней»: recipe — блюда, daymenu — меню на день, week — план на 3 дня, missing — замены
LIMITS_FREE=recipe=3/1,daymenu=1/7,week=0/3,missing=2/1
LIMITS_PREMIUM=recipe=6/1,daymenu=2/1,week=1/2,missing=10/1
LIMITS_ANON=recipe=1/1,daymenu=0/1,week=0/3,missing=1/1
# Только для подписки: memory (профиль и полка), pdf, cart (корзина ВкусВилла с ценами), noads (сайт без рекламы)
PREMIUM_FEATURES=memory,pdf,cart,noads
# Пробный полный доступ — включается сам при первом упоре в лимит (0 — без пробного)
TRIAL_DAYS=7
# Тарифы: имя=дни:цена_в_рублях:цена_в_звёздах
PREMIUM_PLANS=month=30:199:150,year=365:1490:1100
# Промокоды для блогеров и акций: КОД=дней через запятую
PROMO_CODES=
# Оплата: Telegram Stars работают сразу; рубли — токен платёжного сервиса из @BotFather → Payments
PAYMENT_STARS_ENABLED=true
PAYMENT_PROVIDER_TOKEN=
# Твой id в Telegram (узнать: @userinfobot) — тревоги (80% потолка, мало денег на DeepSeek) и команда /grant
ADMIN_TG_IDS=
BOT_USERNAME=Cookingvkusno_bot
DEEPSEEK_BALANCE_ALERT_USD=3
# Пароль партнёра (блогера) для /admin — видит статистику и деньги, меняет цены, лимиты, промокоды
# (потолок расходов, включение подписки и доли — только по ADMIN_PASSWORD). Тарифы удобнее менять в админке.
PARTNER_PASSWORD=
PARTNER_SHARE_PCT=50
