# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Основной провайдер LLM: deepseek, groq или openrouter.
# При сбое/пустом ответе основного бот автоматически пробует остальные по порядку
# deepseek -> groq -> openrouter (у кого задан ключ).
LLM_PROVIDER=deepseek

# Ключ DeepSeek (platform.deepseek.com) — основной провайдер.
# deepseek-chat = БЕЗ размышлений (быстрее, не тратит токены на скрытые "мысли").
# deepseek-reasoner = с цепочкой рассуждений (медленнее и дороже).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ключ Groq (console.groq.com) — резервный провайдер, бесплатный, быстрый
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ключ OpenRouter (openrouter.ai/keys) — если LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ежедневное напоминание "что приготовить завтра"
REMINDER_ENABLED=true
REMINDER_HOUR=14
REMINDER_MINUTE=0
REMINDER_TIMEZONE=Europe/Moscow
