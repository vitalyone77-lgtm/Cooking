# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Основной провайдер LLM: deepseek, groq или openrouter.
# При сбое/пустом ответе основного бот автоматически пробует остальные по порядку
# deepseek -> groq -> openrouter (у кого задан ключ).
LLM_PROVIDER=deepseek

# Ключ DeepSeek (platform.deepseek.com) — основной провайдер.
# Старые имена deepseek-chat/deepseek-reasoner отключаются 24.07.2026 — не используем.
# Текущая модель — deepseek-flash; thinking (режим рассуждений) у неё ВКЛЮЧЁН по
# умолчанию, поэтому ai.py явно отправляет thinking:disabled в каждом запросе.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Ключ Groq (console.groq.com) — резервный провайдер, бесплатный, быстрый
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ключ OpenRouter (openrouter.ai/keys) — если LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Поиск в интернете: Tavily (tavily.com) — основной, платный API, без рейтлимитов.
# Если ключ не задан или запрос не удался — резерв: DuckDuckGo (бесплатно).
TAVILY_API_KEY=

# Ежедневное напоминание "что приготовить завтра"
REMINDER_ENABLED=true
REMINDER_HOUR=14
REMINDER_MINUTE=0
REMINDER_TIMEZONE=Europe/Moscow
