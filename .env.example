# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Провайдер LLM: groq или openrouter
LLM_PROVIDER=groq

# Ключ Groq (console.groq.com) — бесплатный, быстрый
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ключ OpenRouter (openrouter.ai/keys) — если LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ежедневное напоминание "что приготовить завтра"
REMINDER_ENABLED=true
REMINDER_HOUR=14
REMINDER_MINUTE=0
REMINDER_TIMEZONE=Europe/Moscow
